# Copy this file to `.env` and fill in what you need. `.env` is git-ignored.
# Every setting is optional: with none set, Hearth runs locally in demo-friendly mode.

# --- Core -------------------------------------------------------------------
# Signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
HEARTH_SECRET_KEY=
# Where the SQLite database lives (default: instance/hearth.sqlite3).
HEARTH_DATABASE=
# The address people use to reach Hearth; used for links inside emails.
HEARTH_BASE_URL=http://localhost:5000
# Load the fictional example circle when the database is empty.
HEARTH_DEMO_MODE=1
# How long a sign-in lasts, in hours.
HEARTH_SESSION_HOURS=72
# Set to 1 when serving over HTTPS (always in production).
HEARTH_SECURE_COOKIES=0
# Set to 1 when running behind exactly one proxy or load balancer (e.g. Cloud Run).
HEARTH_TRUST_PROXY=0

# --- Reminder job -------------------------------------------------------------
# Run the reminder check inside the app every N seconds (handy on one machine).
HEARTH_RUN_SCHEDULER=1
HEARTH_SCHEDULER_SECONDS=60
# Or let an external scheduler call POST /tasks/reminders with
# "Authorization: Bearer <token>". Leave empty to disable that endpoint.
HEARTH_TASK_TOKEN=

# --- Email (optional) ---------------------------------------------------------
# Without SMTP_HOST, emails are not sent: they appear on the in-app Outbox page.
# For Gmail, create an App Password (Google Account > Security) and use it here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1

# --- Gemini (optional) --------------------------------------------------------
# Lets people describe a medicine in a sentence and have the form filled in.
# Without a key, Hearth's built-in parser does the same job.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
